#version 430 core

// Hi-Z, one level from the previous one (nthshaders.gpu.HiZ): the LARGEST value of each 2x2 texel block (3 on the last
// row/column when the previous level has an odd size), so each texel covers everything below it.

layout(local_size_x = 16, local_size_y = 16) in;

uniform sampler2D u_Src;
uniform int u_SrcLevel;
layout(r32f, binding = 0) writeonly uniform image2D u_Out;

void main() {
    ivec2 o = ivec2(gl_GlobalInvocationID.xy);
    ivec2 osize = imageSize(u_Out);
    if (o.x >= osize.x || o.y >= osize.y) {
        return;
    }
    ivec2 ssize = textureSize(u_Src, u_SrcLevel);
    ivec2 s0 = o * 2;
    int nx = (o.x == osize.x - 1) ? ssize.x - s0.x : 2;
    int ny = (o.y == osize.y - 1) ? ssize.y - s0.y : 2;
    nx = clamp(nx, 1, 3);
    ny = clamp(ny, 1, 3);
    float m = 0.0;
    for (int y = 0; y < ny; y++) {
        for (int x = 0; x < nx; x++) {
            ivec2 s = min(s0 + ivec2(x, y), ssize - ivec2(1));
            m = max(m, texelFetch(u_Src, s, u_SrcLevel).r);
        }
    }
    imageStore(u_Out, o, vec4(m, 0.0, 0.0, 0.0));
}
